# 실제 .env는 chmod 600으로 제한하고 Git에 넣지 않습니다.
# 비밀번호와 인증은 운영자가 채웁니다. LOCAL/PROD 값은 자동 대체되지 않습니다.
LOCAL_DB_URL=jdbc:postgresql://127.0.0.1:5432/more_naive_local
LOCAL_DB_DATABASE=more_naive_local
LOCAL_DB_USERNAME=more_naive_local
LOCAL_DB_PASSWORD=
LOCAL_DB_PORT=5432

PROD_DB_DATABASE=more_naive
PROD_DB_USERNAME=more_naive
PROD_DB_PASSWORD=
PROD_KUBE_CONTEXT=
PROD_KUBE_SERVER=
PROD_NAMESPACE=more-naive-prod

# public repository라면 비워 둡니다. 비공개 read-only 접근에만 사용합니다.
ARGO_REPO_USERNAME=
ARGO_REPO_TOKEN=

# RustFS 자체 bootstrap: 관리 호스트 Docker와 캐시 밖 절대 경로.
RUSTFS_ADMIN_ACCESS_KEY=
RUSTFS_ADMIN_SECRET_KEY=
RUSTFS_DATA_DIR=
RUSTFS_STATE_PATH=
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_NAME=more-naive-rustfs
RUSTFS_BUCKET=more-naive-state
RUSTFS_REGION=us-east-1
# state 전용 제한 인증. cloud provider 인증과 별도로 보관합니다.
RUSTFS_STATE_ACCESS_KEY=
RUSTFS_STATE_SECRET_KEY=

# k3s 노드. 개인키는 파일 경로만 입력합니다.
PROD_SSH_HOST=
PROD_SSH_USER=study
PROD_SSH_KEY_FILE=
K3S_NODE_NAME=
K3S_ROLE=server
K3S_SERVER_URL=
K3S_TOKEN=

# 기존 등록 노드는 재가입하지 않습니다. 최초 등록시에만 AUTH_KEY 사용.
TAILSCALE_NODE_NAME=
TAILSCALE_AUTH_KEY=
TAILSCALE_TAGS=

# 기존 proxy VM 및 실제 확인한 Istio 사설 upstream.
PROXY_SSH_HOST=study-k3s-access.tail373827.ts.net
PROXY_SSH_USER=study
PROXY_SSH_KEY_FILE=
PROXY_HTTPS_HOSTNAME=
ISTIO_UPSTREAM_URL=
