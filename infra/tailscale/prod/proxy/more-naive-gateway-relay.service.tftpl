[Unit]
Description=More Naive Istio gateway private relay
After=network-online.target k3s.service
Wants=network-online.target
Requires=k3s.service
PartOf=k3s.service
[Service]
ExecStart=/usr/local/bin/k3s kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml -n istio-system port-forward --address=${address} service/istio-ingressgateway ${port}:80
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
