# env.dev와 env.prod의 공통 템플릿입니다. 두 파일은 같은 키를 사용합니다.
# 필요한 환경 파일로 복사한 뒤 값을 채우고 chmod 600으로 제한합니다.
DB_URL=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PORT=5432
REDIS_PASSWORD=

KUBE_CONTEXT=
KUBE_SERVER=
NAMESPACE=

# public repository라면 비워 둡니다. 비공개 read-only 접근에만 사용합니다.
ARGO_REPO_USERNAME=
ARGO_REPO_TOKEN=

# 선택 입력. admin 비밀번호의 bcrypt 해시이며 평문 비밀번호를 넣지 않습니다.
# 비워 두면 Argo CD의 기존/초기 비밀번호를 유지합니다.
ARGOCD_ADMIN_PASSWORD_HASH=

# RustFS 자체 bootstrap: 관리 호스트 Docker와 캐시 밖 절대 경로.
RUSTFS_ADMIN_ACCESS_KEY=
RUSTFS_ADMIN_SECRET_KEY=
RUSTFS_DATA_DIR=
RUSTFS_STATE_PATH=
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_NAME=more-naive-rustfs
RUSTFS_BUCKET=more-naive-state
RUSTFS_REGION=us-east-1
# 기존 외부 state credential profile의 절대 경로. 파일 생성/교체는 자동화하지 않습니다.
# [more-naive-state] 및 [profile more-naive-state] 섹션을 같은 파일에 준비합니다.
RUSTFS_CREDENTIALS_FILE=

# k3s 노드. 개인키는 파일 경로만 입력합니다.
SSH_HOST=
SSH_USER=study
SSH_KEY_FILE=
SSH_HOST_KEY=
K3S_NODE_NAME=
K3S_ROLE=server
K3S_SERVER_URL=
K3S_TOKEN=

# prod 릴레이 점검과 smoke의 tailnet HTTPS 호스트.
# prod KUBE_SERVER는 https://more-naive-vm.tail373827.ts.net:6443을 사용합니다.
PROXY_EXPECTED_HOST=
PROXY_HTTPS_HOSTNAME=
